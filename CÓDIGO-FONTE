using System;
using System.Collections.Generic;

public interface IAvaliavel
{
    void AdicionarAvaliacao(Avaliacao avaliacao);
}

public interface Ipesquisavel
{
    bool PossuiAvaliacao(Avaliacao avaliacao);                //Interfaces
}

public interface IRemovível
{
    void Remover();
}

public interface IAtualizar
{
    void Atualizar();
}

public abstract class Midia : IAvaliavel
{
    public int Id { get; private set; }
    public string? Titulo { get; set; }
    public List<string> Genero { get; set; } = new List<string>();
    public int AnoLancamento { get; set; }
    public string? Sinopse { get; set; }

    protected List<Avaliacao> avaliacoes { get; set; } = new List<Avaliacao>();            // Classe abstrata

    public Midia(int Id, string Titulo, int AnoLancamento, string Sinopse)
    {
        this.Id = Id;
        this.Titulo = Titulo;
        this.AnoLancamento = AnoLancamento;
        this.Sinopse = Sinopse;
    }

    public double MediaNota
    {
        get
        {
            if (avaliacoes.Count == 0)
            {
                return 0;
            }
            return avaliacoes.Average(a => a.Nota);
        }
    }

    public abstract void ExibirInfo();

    public void AdicionarAvaliacao(Avaliacao avaliacao)
    {
        if (avaliacao.Nota < 0 || avaliacao.Nota > 10)
        {
            throw new Exception("A nota deve estar entre 0 e 10");
        }

        avaliacoes.Add(avaliacao);
    }
}

public partial class Filme : Midia, Ipesquisavel, IAtualizar
{
    public string? Diretor { get; set; }
    public int Duracao { get; set; }

    public Filme(int Id, string Titulo, int AnoLancamento, string Sinopse, string Diretor, int Duracao)          // Classe parcial
        : base(Id, Titulo, AnoLancamento, Sinopse)
    {
        this.Diretor = Diretor;
        this.Duracao = Duracao;
    }

    public override void ExibirInfo()
    {
        Console.WriteLine(
            $"Filme : {Titulo} | ID: {Id} | Diretor: {Diretor} | Duração: {Duracao} | " +
            $"Gênero: {string.Join(", ", Genero)} | Ano: {AnoLancamento} | Sinopse: {Sinopse}"
        );
    }

    public void AdicionarAvaliacao(Avaliacao avaliacao)
    {
        base.AdicionarAvaliacao(avaliacao);
    }

    public bool PossuiAvaliacao(Avaliacao ava)
    {
        if (!avaliacoes.Contains(ava))
        {
            return false;
        }

        return true;
    }

    public void Atualizar()
    {
        Console.WriteLine($"Atualizando informações sobre o filme: {Titulo}");
    }
}


