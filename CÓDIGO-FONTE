using System;
using System.Collections.Generic;

interface IAvaliavel
{
    void AdicionarAvaliacao(Avaliacao avaliacao);
}

public abstract class Midia : IAvaliavel
{
    public int Id { get; private set; }
    public string? Titulo { get; set; }
    public List<string> Genero { get; set; } = new List<string>();
    public int AnoLancamento { get; set; }
    public string? Sinopse { get; set; }

    public List<Avaliacao> avaliacoes { get; set; } = new List<Avaliacao>();

    public Midia(int Id, string Titulo, int AnoLancamento, string Sinopse)
    {
        this.Id = Id;
        this.Titulo = Titulo;
        this.AnoLancamento = AnoLancamento;
        this.Sinopse = Sinopse;
    }

    public double MediaNota
    {
        get
        {
            if (avaliacoes.Count == 0)
            {
                return 0;
            }
            return avaliacoes.Average(a => a.Nota);
        }
    }

    public abstract void ExibirInfo();

    public void AdicionarAvaliacao(Avaliacao avaliacao)
    {
        if (avaliacao.Nota < 0 || avaliacao.Nota > 10)
        {
            throw new Exception("A nota deve estar entre 0 e 10");
        }

        avaliacoes.Add(avaliacao);
    }
}

